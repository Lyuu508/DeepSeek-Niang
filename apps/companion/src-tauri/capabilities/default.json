{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-local",
  "description": "Local application window only. No remote URLs, filesystem or shell plugin permissions.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "allow-set-font-scale",
    "allow-list-recycled-personas",
    "allow-change-recycled-personas",
    "allow-inspect-plugin",
    "allow-list-plugins",
    "allow-change-plugin",
    "allow-due-plugin-reminders",
    "notification:allow-is-permission-granted",
    "notification:allow-request-permission",
    "notification:allow-notify",
    "allow-sync-status",
    "allow-sync-command",
    "allow-bootstrap",
    "allow-list-messages",
    "allow-create-persona",
    "allow-select-persona",
    "allow-save-chat-settings",
    "allow-set-api-key",
    "allow-delete-api-key",
    "allow-vault-self-test",
    "allow-start-chat",
    "allow-stop-generation",
    "allow-diagnostics",
    "allow-list-memories",
    "allow-save-memory",
    "allow-delete-memory",
    "allow-companion-snapshot",
    "allow-save-companion-preferences",
    "allow-edit-companion-memory",
    "allow-resolve-memory-candidate",
    "allow-life-plan-create",
    "allow-life-task-control",
    "allow-life-diary",
    "allow-share-receipt",
    "allow-claim-share-notification"
  ]
}
