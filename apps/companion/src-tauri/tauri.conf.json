{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeepSeek娘",
  "version": "0.0.1",
  "identifier": "io.local.deepseekcompanion",
  "build": {
    "beforeDevCommand": "node ../../scripts/check-branding.mjs && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node ../../scripts/check-branding.mjs && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DeepSeek娘",
        "width": 1200,
        "height": 850,
        "minWidth": 360,
        "minHeight": 600,
        "useHttpsScheme": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost https://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'",
      "devCsp": "default-src 'self'; connect-src ipc: http://ipc.localhost https://ipc.localhost http://localhost:1420 http://127.0.0.1:1420 ws://localhost:1420 ws://127.0.0.1:1420; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "android": {
      "minSdkVersion": 29,
      "versionCode": 1001
    }
  }
}
